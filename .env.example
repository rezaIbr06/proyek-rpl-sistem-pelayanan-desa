# ==========================================
# KONFIGURASI DATABASE
# ==========================================
DATABASE_URL="file:./dev.db"

# ==========================================
# AUTENTIKASI SESSION
# ==========================================
SESSION_SECRET=

# ==========================================
# AI / LLM API
# ==========================================
NVIDIA_API_KEY=

# ==========================================
# NOTIFIKASI WHATSAPP (WhatsApp Cloud API)
# ==========================================
# Aktifkan/nonaktifkan saluran WhatsApp
WHATSAPP_ENABLED=false

# Opsi 1: Fonnte WhatsApp Gateway (https://fonnte.com) - Sangat mudah digunakan di Indonesia
FONNTE_TOKEN=

# Opsi 2: Meta WhatsApp Cloud API (Graph API)
# Dari Meta for Developers > WhatsApp > Getting Started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# Token verifikasi webhook (bebas tentukan sendiri, cocokkan di Meta Dashboard)
WHATSAPP_VERIFY_TOKEN=

# App Secret untuk verifikasi signature webhook POST (dari Meta App > Settings > Basic)
WHATSAPP_APP_SECRET=

# ==========================================
# NOTIFIKASI EMAIL (Gmail)
# ==========================================
# Aktifkan/nonaktifkan saluran email
GMAIL_ENABLED=false

# Alamat email pengirim (harus dikonfigurasi eksplisit)
GMAIL_SENDER_EMAIL=

# --- PILIHAN A: OAuth2 (direkomendasikan) ---
# Dari Google Cloud Console > Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- PILIHAN B: App Password (alternatif jika tidak menggunakan OAuth2) ---
# Dari Google Account > Security > 2-Step Verification > App Passwords
GMAIL_APP_PASSWORD=

# ==========================================
# URL APLIKASI (untuk link dalam email)
# ==========================================
APP_BASE_URL=http://localhost:3000
